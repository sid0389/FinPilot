# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB (get free cluster at mongodb.com/atlas) ─────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finpilot?retryWrites=true&w=majority
# Local alternative:
# MONGODB_URI=mongodb://localhost:27017/finpilot

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Anthropic Claude AI (get key at console.anthropic.com) ──────
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
CHAT_MODEL=claude-haiku-5-5   # model used by the chatbot
